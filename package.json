{
  "name": "cdn-proxy-cache",
  "version": "0.2.0",
  "description": "A caching proxy for CDN resources with URL rewriting, content transformation, and Express integration",
  "keywords": [
    "proxy",
    "cache",
    "cdn",
    "express",
    "middleware",
    "offline"
  ],
  "homepage": "https://github.com/osteele/cdn-proxy-cache",
  "bugs": {
    "url": "https://github.com/osteele/cdn-proxy-cache/issues"
  },
  "license": "MIT",
  "author": "Oliver Steele <steele@osteele.com> (https://osteele.com/)",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/osteele/cdn-proxy-cache.git"
  },
  "scripts": {
    "build": "rm -rf dist && tsc --declaration && cp -R src/templates dist/templates",
    "clean": "rm -rf dist",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src tests",
    "format": "biome format --write src tests",
    "format-check": "biome ci src tests",
    "fix": "biome check --write src tests",
    "check": "bun run format-check && bun run lint && bun run typecheck && bun test",
    "prepublishOnly": "bun run check && bun run build"
  },
  "dependencies": {
    "cacache": "^19.0.1",
    "css-tree": "^3.2.1",
    "debug": "^4.4.3",
    "node-fetch": "^2.7.0",
    "node-html-parser": "^9.0.1",
    "nunjucks": "^3.2.4"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@types/cacache": "^20.0.1",
    "@types/css-tree": "^3.2.0",
    "@types/debug": "^4.1.13",
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "@types/node-fetch": "^2.6.13",
    "@types/nunjucks": "^3.2.6",
    "bun-types": "^1.3.14",
    "express": "^5.2.1",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "express": ">=4.18 <6"
  },
  "overrides": {
    "form-data": "^4.0.6"
  },
  "engines": {
    "node": ">=18.17"
  }
}
