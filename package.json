{
  "name": "cdn-proxy-cache",
  "version": "0.1.0",
  "description": "A caching proxy for CDN resources with URL rewriting, content transformation, and Express integration",
  "keywords": [
    "proxy",
    "cache",
    "cdn",
    "express",
    "middleware",
    "offline"
  ],
  "homepage": "https://github.com/osteele/cdn-proxy-cache",
  "bugs": {
    "url": "https://github.com/osteele/cdn-proxy-cache/issues"
  },
  "license": "MIT",
  "author": "Oliver Steele <steele@osteele.com> (https://osteele.com/)",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/osteele/cdn-proxy-cache.git"
  },
  "scripts": {
    "build": "bun run clean && tsc --declaration",
    "clean": "rm -rf dist",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src tests",
    "format": "biome format --write src tests",
    "check": "bun run format && bun run lint && bun run typecheck && bun test",
    "prepublishOnly": "bun run check && bun run build"
  },
  "dependencies": {
    "cacache": "^15.3.0",
    "css-tree": "^2.0.1",
    "debug": "^4.3.4",
    "express": "^4.17.1",
    "node-fetch": "^2.6.6",
    "node-html-parser": "^7.0.1",
    "nunjucks": "^3.2.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/cacache": "^15.0.1",
    "@types/css-tree": "^1.0.7",
    "@types/debug": "^4.1.7",
    "@types/express": "^4.17.13",
    "@types/node": "^20.1.0",
    "@types/node-fetch": "^2.5.12",
    "@types/nunjucks": "^3.2.0",
    "bun-types": "^1.0.0",
    "typescript": "^5.0.4"
  },
  "engines": {
    "node": ">=14.17"
  }
}
